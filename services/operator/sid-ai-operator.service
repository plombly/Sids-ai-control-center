# Host-side executor for operator actions requested from the Web.
# Install (operator decision):
#   cp services/operator/sid-ai-operator.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now sid-ai-operator.service
# Supported actions: approve merges the exact integrated candidate (ff-only);
# queue_approve queues an approval bound to the exact source commits;
# dequeue_approve removes a queued approval; reject, extend, reintegrate and
# reopen behave as in scripts/job-review.py.
# approve and queue_approve are not in the default OPERATOR_ALLOWED_ACTIONS.
# Add them only when SID_OPERATOR_TOKEN is configured in
# /etc/sid-ai/operator.env, because the API refuses these actions when no token
# is configured. Also add them only once the API is not reachable by people who
# must not approve merges. dequeue_approve is safe to enable by default because
# it only withdraws a queued approval.
# Example with all actions enabled:
#   Environment=OPERATOR_ALLOWED_ACTIONS=approve,queue_approve,dequeue_approve,reject,extend,reintegrate,reopen
# job-review.py is loaded at start: restart this unit after changing it.
[Unit]
Description=SID AI Command Center Operator Actions
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sids-ai-command-center
Environment=PYTHONUNBUFFERED=1
Environment=REDIS_URL=redis://127.0.0.1:6379/0
Environment=REPO_ROOT=/opt/sids-ai-command-center
Environment=WORKTREE_ROOT=/opt/sid-worktrees
Environment=OPERATOR_ID=sid-operator-01
Environment=OPERATOR_ALLOWED_ACTIONS=reject,extend,reintegrate,reopen,dequeue_approve,network_once,network_always,network_deny
Environment=OPERATOR_REQUEST_TTL=600
ExecStart=/usr/bin/python3 /opt/sids-ai-command-center/services/operator/sid_operator.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
