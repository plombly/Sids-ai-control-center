# Where this edition of LAIka looks for updates (scripts/laika-update.py):
# a folder holding manifest.json, manifest.json.sig and the release
# tarball, e.g. https://github.com/<owner>/<repo>/releases/latest/download/
# Settings → General → Update address overrides it (empty there: this one).
LAIKA_UPDATE_URL=https://github.com/plombly/LAIka/releases/latest/download/
