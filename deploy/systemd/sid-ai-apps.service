[Unit]
Description=SID AI Command Center: keep project apps running (sid-app-<id> units)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sids-ai-command-center
Environment=PYTHONUNBUFFERED=1
Environment=REDIS_URL=redis://127.0.0.1:6379/0
ExecStart=/usr/bin/python3 /opt/sids-ai-command-center/services/apps/sid_apps.py
Restart=always
RestartSec=5
# Stopping this service leaves the apps running (they are their own units).
KillMode=process

[Install]
WantedBy=multi-user.target
