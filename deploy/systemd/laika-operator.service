# Host-side executor for operator actions requested from the Web.
# Install (operator decision):
#   cp services/operator/laika-operator.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now laika-operator.service
# Supported actions: approve merges the exact integrated candidate (ff-only);
# queue_approve queues an approval bound to the exact source commits;
# dequeue_approve removes a queued approval; reject, extend, reintegrate and
# reopen behave as in scripts/job-review.py.
# approve and queue_approve are not in the default OPERATOR_ALLOWED_ACTIONS.
# Add them only when LAIKA_OPERATOR_TOKEN is configured in
# /etc/laika/operator.env, because the API refuses these actions when no token
# is configured. Also add them only once the API is not reachable by people who
# must not approve merges. dequeue_approve is safe to enable by default because
# it only withdraws a queued approval.
# Example with all actions enabled:
#   Environment=OPERATOR_ALLOWED_ACTIONS=approve,queue_approve,dequeue_approve,reject,extend,reintegrate,reopen
# job-review.py is loaded at start: restart this unit after changing it.
[Unit]
Description=LAIka Operator Actions
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=root
# Root for units, Docker and firewall rules; files it creates in LAIka's
# shared data stay usable by the laika group (services/laika_user.py).
UMask=0007
Environment=GIT_CONFIG_GLOBAL=/etc/laika/gitconfig
Type=simple
WorkingDirectory=/opt/laika
Environment=PYTHONUNBUFFERED=1
Environment=REDIS_URL=redis://127.0.0.1:6379/0
Environment=REPO_ROOT=/opt/laika
Environment=WORKTREE_ROOT=/var/lib/laika/worktrees
Environment=OPERATOR_ID=laika-operator-01
Environment=OPERATOR_ALLOWED_ACTIONS=approve,queue_approve,dequeue_approve,reject,extend,reintegrate,reopen,create_project,project_retry_clone,project_push_setup,delete_project,project_commit_upload,restore_project,project_revert,network_once,network_always,network_deny,apply_settings,provider_login,provider_status,provider_apply_keys,system_update
Environment=OPERATOR_REQUEST_TTL=600
ExecStart=/var/lib/laika/venv/bin/python /opt/laika/services/operator/laika_operator.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
