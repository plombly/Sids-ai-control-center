[Unit]
Description=SID AI Command Center health watchdog
After=docker.service

[Service]
Type=oneshot
Environment=REDIS_URL=redis://127.0.0.1:6379/0
Environment=REPO_ROOT=/opt/sids-ai-command-center
Environment=WATCHDOG_WORKERS=6
ExecStart=/usr/bin/python3 /opt/sids-ai-command-center/scripts/sid-watchdog.py
