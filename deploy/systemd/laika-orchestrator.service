[Unit]
Description=LAIka orchestrator
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=laika
Group=laika
# The dedicated user (services/laika_user.py): agents and tests never run as
# root. Shared data stays group-writable for the root control services.
UMask=0007
Environment=HOME=/var/lib/laika/home
Environment=GIT_CONFIG_GLOBAL=/etc/laika/gitconfig
# The claude CLI cannot update itself here; `laika update` updates it.
Environment=DISABLE_AUTOUPDATER=1
# Secrets as environment (read by systemd; the files stay root-only).
EnvironmentFile=-/etc/laika/redis.env
Type=simple
WorkingDirectory=/opt/laika
Environment=PYTHONUNBUFFERED=1
Environment=REDIS_URL=redis://127.0.0.1:6379/0
Environment=GOAL_QUEUE=laika:goals
Environment=WORKER_QUEUE=laika:jobs
Environment=ORCHESTRATOR_ID=laika-orchestrator-01
Environment=LAIKA_PYTHON=/var/lib/laika/venv/bin/python
EnvironmentFile=-/etc/laika/laika.env
EnvironmentFile=-/etc/laika/providers/providers.env
ExecStart=/var/lib/laika/venv/bin/python /opt/laika/services/orchestrator/orchestrator.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
