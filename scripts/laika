#!/bin/bash
# The LAIka command (installed as /usr/local/bin/laika).
#
#   laika status            services, workers and health at a glance
#   laika setup-code        one-time code for the first-run web setup
#   laika reset-password    new administrator password (signs everyone out)
#   laika restart [TARGET]  restart services safely (default: all)
#   laika logs [UNIT]       follow a service's log (default: orchestrator)
#   laika doctor            check this installation and explain problems
#   laika update            install the latest release (backup first)
#   laika branding apply    rebuild the web assets from /etc/laika/branding.json
#   laika version           show the installed version
set -uo pipefail
LAIKA_HOME=${LAIKA_HOME:-/opt/laika}
PY=/usr/bin/python3
need_root() { [ "$(id -u)" = 0 ] || { echo "Run this with sudo." >&2; exit 2; }; }

case "${1:-help}" in
  status)
    systemctl --no-pager --plain list-units 'laika-*' --type=service --state=running,failed | sed -n '1,40p'
    curl -s --max-time 5 http://127.0.0.1:8000/health; echo ;;
  setup-code) need_root; exec $PY "$LAIKA_HOME/scripts/laika-admin.py" setup-code ;;
  reset-password) need_root; exec $PY "$LAIKA_HOME/scripts/laika-admin.py" reset-password ;;
  restart) need_root; shift; exec "$LAIKA_HOME/scripts/laika-restart.sh" "${@:-all}" ;;
  logs) exec journalctl -f -u "laika-${2:-orchestrator}" ;;
  doctor)
    if [ -x "$LAIKA_HOME/scripts/laika-doctor.py" ]; then exec $PY "$LAIKA_HOME/scripts/laika-doctor.py"; fi
    echo "doctor is not installed in this version" >&2; exit 1 ;;
  update)
    need_root
    if [ -x "$LAIKA_HOME/scripts/laika-update.py" ]; then exec $PY "$LAIKA_HOME/scripts/laika-update.py" "${@:2}"; fi
    echo "updates are not available in this version" >&2; exit 1 ;;
  branding)
    need_root
    if [ "${2:-}" = apply ] && [ -x "$LAIKA_HOME/scripts/laika-branding.py" ]; then exec $PY "$LAIKA_HOME/scripts/laika-branding.py" apply; fi
    echo "usage: laika branding apply" >&2; exit 2 ;;
  version) cat "$LAIKA_HOME/VERSION" 2>/dev/null || git -C "$LAIKA_HOME" describe --always 2>/dev/null ;;
  help|-h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown command: $1 (laika help)" >&2; exit 2 ;;
esac
